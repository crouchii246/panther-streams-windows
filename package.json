{
  "name": "panther-streams-windows",
  "version": "0.5.0",
  "private": true,
  "description": "Panther Streams Windows desktop v0.5.0 - installation and connectivity test build",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist:win": "electron-builder --win nsis",
    "check": "node --check main.js && node --check preload.js && node --check renderer.js"
  },
  "devDependencies": {
    "electron": "^33.4.11",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.pantherstreams.windows",
    "productName": "Panther Streams",
    "files": [
      "main.js",
      "preload.js",
      "renderer.js",
      "index.html",
      "styles.css"
    ],
    "win": {
      "target": [
        "nsis"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "artifactName": "Panther-Streams-Setup-${version}.${ext}"
    }
  }
}
